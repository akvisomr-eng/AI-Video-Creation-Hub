# Use the Neon development branch while building and testing.
# Keep real credentials in your local environment or hosting secret settings.
DATABASE_URL=

# Neon Auth URL for the SAME branch used by DATABASE_URL.
NEON_AUTH_BASE_URL=
# Generate a unique secret of at least 32 characters, e.g. openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Text AI providers are optional. The gateway tries configured providers in AI_TEXT_PROVIDER_ORDER.
# Free tiers are quota-limited; no API provider is unlimited or guaranteed free.
AI_TEXT_PROVIDER_ORDER=gemini,groq,cerebras,openrouter
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
CEREBRAS_API_KEY=
CEREBRAS_TEXT_MODEL=gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openrouter/free
APP_PUBLIC_URL=http://localhost:3000
# Optional independent second-pass quality reviewer; consumes another provider request per storyboard.
AI_MULTI_AGENT_ENABLED=false

# Protects the internal asynchronous worker endpoint. Generate a unique 32+ character secret.
GENERATION_WORKER_SECRET=

# Image/video/audio generation adapters are separate and not yet implemented.
IMAGE_PROVIDER_API_KEY=
VIDEO_PROVIDER_API_KEY=
TTS_PROVIDER_API_KEY=

# Neon Object Storage (branch-scoped S3-compatible credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1
NEON_STORAGE_BUCKET=creator-media
# Optional exact app origin for storage CORS configuration
APP_ORIGIN=
