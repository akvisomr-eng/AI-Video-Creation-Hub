# Use the Neon development branch while building and testing.
# Keep real credentials in your local environment or hosting secret settings.
DATABASE_URL=

# Neon Auth URL for the SAME branch used by DATABASE_URL.
NEON_AUTH_BASE_URL=
# Generate a unique secret of at least 32 characters, e.g. openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Set only when a real provider has been selected and its adapter is implemented.
IMAGE_PROVIDER_API_KEY=
VIDEO_PROVIDER_API_KEY=
TTS_PROVIDER_API_KEY=
